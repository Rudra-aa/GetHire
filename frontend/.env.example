# GetHire Frontend — Vercel Environment Variables
# =================================================

# Backend API Base URL
# In Production (Vercel): Set this to your deployed Render service URL (e.g. https://gethire-backend.onrender.com)
# In Local Development: Leave empty to use Vite local proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=https://gethire-backend.onrender.com
