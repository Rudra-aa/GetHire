# GetHire — Environment Variables
# =================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# In Docker Compose, environment variables defined in docker-compose.yml take
# precedence over this file. Use this file only to override values locally.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=GetHire
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. Minimum 32 characters.
SECRET_KEY=change-me-before-production-minimum-32-chars-random-value-here

# ── MongoDB ────────────────────────────────────────────────────────────────
# Docker Compose: mongodb://mongo:27017
# Atlas:          mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=gethire

# ── Redis ──────────────────────────────────────────────────────────────────
# Docker Compose: redis://redis:6379/0
# Production:     rediss://user:pass@host:6380/0
REDIS_URL=redis://redis:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Ollama AI Runtime (Sprint 3) ───────────────────────────────────────────
# For running Ollama on the host machine accessible from Docker:
OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIMARY_MODEL=qwen2.5:7b
FALLBACK_MODEL=llama3.2:3b

# ── File Upload ────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/gethire/uploads
MAX_UPLOAD_SIZE_MB=5

# ── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_FACESENSE_ENABLED=true
FEATURE_VOICESENSE_ENABLED=true

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Only VITE_ prefixed variables are exposed to the browser.
# Empty = use Vite proxy (recommended for Docker Compose development).
# Set to backend URL for standalone frontend deployments.
VITE_API_BASE_URL=
