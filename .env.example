# GetHire — Environment Variables Template
# ==========================================
# Copy this file to .env and customize for your local or production environment.
# NEVER commit actual secrets (.env) to version control.
#
# In Docker Compose, variables defined in docker-compose.yml take precedence
# unless overridden in .env.

# ── Application Runtime ────────────────────────────────────────────────────
APP_NAME=GetHire
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Security & Authentication ──────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. Minimum 32 random characters.
SECRET_KEY=change-me-before-production-minimum-32-chars-random-value-here
ALLOWED_HOSTS=["*","localhost","127.0.0.1","*.onrender.com","*.vercel.app"]

# ── CORS & Public URLs ─────────────────────────────────────────────────────
# Allowed origins for frontend clients (Vercel, local development)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.vercel.app"]
# Canonical production frontend URL for public recruiter links (e.g. https://gethire.app)
PUBLIC_APP_URL=https://gethire.app

# ── Database — MongoDB ─────────────────────────────────────────────────────
# Docker Compose: mongodb://mongo:27017
# Atlas:          mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gethire?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=gethire
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# ── Cache — Redis (Optional) ───────────────────────────────────────────────
# Docker Compose: redis://redis:6379/0
# Production:     rediss://default:<password>@<redis-host>:6379/0
# Leave empty to run with graceful memory fallback
REDIS_URL=redis://redis:6379/0

# ── AI & Intelligence Providers ────────────────────────────────────────────
# Google Gemini API Key for AI Mock Interview Engine & Turn Evaluation
GEMINI_API_KEY=your-gemini-api-key-here
# Optional Local Ollama Runtime (Sprint 3)
OLLAMA_BASE_URL=http://host.docker.internal:11434
PRIMARY_MODEL=qwen2.5:7b
FALLBACK_MODEL=llama3.2:3b

# ── File Upload & Storage ──────────────────────────────────────────────────
UPLOAD_DIR=/tmp/gethire/uploads
MAX_UPLOAD_SIZE_MB=10

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_AI_PROCESSING_LIMIT=30
RATE_LIMIT_AI_PROCESSING_WINDOW=60

# ── Feature Flags ──────────────────────────────────────────────────────────
FEATURE_FACESENSE_ENABLED=true
FEATURE_VOICESENSE_ENABLED=true

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Leave empty in local dev to use Vite proxy to http://127.0.0.1:8000.
# In production, set to your backend deployment URL (e.g. https://gethire-backend.onrender.com).
VITE_API_BASE_URL=
