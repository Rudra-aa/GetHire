# EditorConfig — https://editorconfig.org
# ==========================================
# Ensures consistent whitespace and line endings across all editors
# and operating systems, regardless of individual developer settings.

root = true

# ── All Files ─────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ── Python ────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 100

# ── Markdown ──────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false   # Trailing spaces are intentional in Markdown

# ── YAML / Docker Compose ─────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── JSON ──────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── Makefile ──────────────────────────────────────────────────────────────
[Makefile]
indent_style = tab   # Make requires tabs, not spaces
