# GetHire Backend — Render / Production Environment Variables
# ============================================================

# ── Application Runtime ──
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=GetHire
APP_VERSION=1.0.0

# ── Security & Authentication ──
# Minimum 32 random characters (can generate via python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-secure-random-32-plus-char-string-in-production

# ── Allowed Hosts & CORS ──
# TrustedHostMiddleware allowlist
ALLOWED_HOSTS=*
# Allowed origins for frontend (Vercel domains, localhost)
CORS_ORIGINS=["https://*.vercel.app","http://localhost:5173","http://localhost:3000"]

# ── Databases ──
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=GetHire
MONGODB_DB_NAME=gethire

# Redis URL (e.g. Render Redis, Upstash, or Redis Cloud)
# Optional in production — app runs in degraded mode if omitted
REDIS_URL=redis://default:<password>@<redis-host>:6379/0

# ── AI & Intelligence ──
# Google Gemini API Key for Interview Engine & Turn Evaluation
GEMINI_API_KEY=AIzaSy...
