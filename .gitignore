# GetHire .gitignore
# ===================

# ── Environment Variables (NEVER COMMIT) ──────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.egg-info/
dist/
build/
*.egg
pip-log.txt

# ── Node / Frontend ────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/

# ── Uploads ────────────────────────────────────────────────────────────────
uploads/
backend/uploads/
/tmp/

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ─────────────────────────────────────────────────────────────────
# Do not ignore Dockerfiles or docker-compose.yml — those are source files.

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── Compiled assets ────────────────────────────────────────────────────────
*.pyc
*.pyo

# ── AI models (large binary files — managed by Ollama separately) ──────────
*.gguf
*.bin
*.safetensors
models/
