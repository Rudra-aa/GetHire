# =========================================================================
# GetHire Git Ignore Configuration
# =========================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# --- Virtual Environments ---
gh/
venv/
.venv/
env/
ENV/

# --- Environment Configurations (Sensitive) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Frontend (React + Vite + Node) ---
frontend/node_modules/
frontend/dist/
frontend/.npm-cache/
frontend/npm_install.log

# --- Logs and Cache ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- OS-specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs / Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Backend Uploads & Reports ---
# Ignore uploaded resumes and generated PDFs, but keep directory structure
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/reports/*
!backend/uploads/reports/.gitkeep
